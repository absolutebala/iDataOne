{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/mealmate.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/contact.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "has": [{ "type": "host", "value": "mealmate.idataone.com" }],
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "has": [{ "type": "host", "value": "mealmate.idataone.com" }],
      "source": "/(.*)",
      "destination": "/api/mealmate.php"
    },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/favicon.png", "destination": "/favicon.png" },
    { "source": "/mealmate/(.*)", "destination": "/mealmate/$1" },
    { "source": "/contact", "destination": "/api/contact.php" },
    { "source": "/(.*)", "destination": "/api/index.php" }
  ]
}
