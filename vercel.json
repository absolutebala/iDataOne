{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/robots.txt", "dest": "/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/sitemap.xml" },
    { "src": "/favicon.png", "dest": "/favicon.png" },
    { "src": "/mealmate/(.*)", "dest": "/mealmate/$1" },
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}
