{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/mealmate.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/contact.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/digital.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/ai.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/data.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/case-studies.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/case-risk-platform.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "api/case-risk-dashboard.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "has": [
        {
          "type": "host",
          "value": "mealmate.idataone.com"
        }
      ],
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/case-study/risk-platform",
      "destination": "/api/case-risk-platform.php"
    },
    {
      "source": "/case-study/risk-dashboard",
      "destination": "/api/case-risk-dashboard.php"
    },
    {
      "has": [
        {
          "type": "host",
          "value": "mealmate.idataone.com"
        }
      ],
      "source": "/(.*)",
      "destination": "/api/mealmate.php"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/favicon.png",
      "destination": "/favicon.png"
    },
    {
      "source": "/mealmate/(.*)",
      "destination": "/mealmate/$1"
    },
    {
      "source": "/contact",
      "destination": "/api/contact.php"
    },
    {
      "source": "/digital",
      "destination": "/api/digital.php"
    },
    {
      "source": "/ai",
      "destination": "/api/ai.php"
    },
    {
      "source": "/data",
      "destination": "/api/data.php"
    },
    {
      "source": "/case-studies",
      "destination": "/api/case-studies.php"
    },
    {
      "source": "/case-study/risk-platform",
      "destination": "/api/case-risk-platform.php"
    },
    {
      "source": "/case-study/risk-dashboard",
      "destination": "/api/case-risk-dashboard.php"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}